# Copy to .env and edit. Every variable is optional except SECRET_KEY, which
# you should always set. docker-compose.yml reads this file automatically.

# --- Core --------------------------------------------------------------------

# Flask secret for sessions and CSRF tokens. If unset, a random key is
# generated at startup (forms break across restarts and across replicas).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# MongoDB connection string and database name.
# (docker-compose.yml overrides MONGO_URI to point at its own db service.)
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=accounting_cloud

# Base path when served under a sub-path by a reverse proxy, e.g. /accounting.
# A proxy can also send an X-Script-Name header instead.
APPLICATION_ROOT=/

# Ledger starting balance used only until you create your first account.
STARTING_BALANCE=0.00

# Debug mode for `python app.py`. Never enable in production.
FLASK_DEBUG=false

# Where uploaded credit-card statement CSVs are kept.
# Default: ./data/cc_statements next to app.py
# CC_STATEMENT_DIR=/app/data/cc_statements

# Container time zone. Schedules (17:00 price refresh, 06:00 advisor reports)
# and "today" in projections use local time, which is UTC unless set.
TZ=UTC

# Escrow simulation on asset amortization pages: months property tax is paid
# (annual bill split evenly) and the month homeowner's insurance renews.
ESCROW_PROPERTY_TAX_MONTHS=6,12
ESCROW_INSURANCE_MONTH=1

# Host ports used by docker-compose.yml (bound to 127.0.0.1).
WEB_PORT=5052

# --- Market data ---------------------------------------------------------------

# Yahoo Finance is used first and needs no key. Alpha Vantage is a fallback.
# Free key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# --- LLM: credit-card categorization & spending tips (optional) ---------------
# Any Ollama-compatible endpoint (/api/chat). If unreachable, categorization
# falls back to the keyword rules and the AI analysis section is hidden.
# From inside Docker, a host-run Ollama is usually http://host.docker.internal:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=granite4.2:3b
# Sent as "Authorization: Bearer <key>" when set. Leave blank for plain Ollama.
OLLAMA_API_KEY=
# Two-vote LLM pass over merchants the keyword rules leave at 'Other'.
CC_LLM_ENABLED=true
CC_LLM_TIMEOUT=60

# --- LLM: advisor reports (optional) -------------------------------------------
# Weekly/monthly/portfolio briefings. Can be a bigger, slower model than the
# categorizer since it runs in the background.
ADVISOR_ENABLED=false
AGENT_OLLAMA_HOST=http://localhost:11434
AGENT_OLLAMA_MODEL=gemma4:e4b
AGENT_OLLAMA_API_KEY=
AGENT_OLLAMA_TIMEOUT=3600
# Optional path to your household profile (see agent/household_profile.example.md).
# In Docker, mount the file into the container and point at the mounted path.
ADVISOR_PROFILE_FILE=

# --- MCP server (optional, `docker compose --profile mcp up`) ------------------
# Required: the MCP server refuses every request until this is set.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_TOKEN=
MCP_PORT=8765
# Public path prefix when a proxy serves the MCP server under a sub-path (e.g. /mcp).
MCP_MOUNT_PATH=
